{
  "name": "mayoiga",
  "version": "0.1.8",
  "description": "Type safe hook based form library for React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "/component.js",
    "/component.d.ts",
    "!*.test.js"
  ],
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "check:type": "tsc --noEmit",
    "check:lint": "biome lint src/",
    "check:style": "biome format src/",
    "check-all": "pnpm run check:type && pnpm run check:style && pnpm run check:lint && pnpm run test",
    "fix:lint": "biome lint src/ --fix",
    "fix-all": "pnpm run check:style --write && pnpm run check:lint --fix",
    "prepublishOnly": "pnpm run check-all && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hachibeeDI/mayoiga.git"
  },
  "keywords": [
    "react",
    "react-dom",
    "forms",
    "validation",
    "state"
  ],
  "author": "OGURA Daiki",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hachibeeDI/mayoiga/issues"
  },
  "homepage": "https://github.com/hachibeeDI/mayoiga#readme",
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "nozuchi": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@types/react": "^19.0.12"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "use-sync-external-store": "^1.7.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
